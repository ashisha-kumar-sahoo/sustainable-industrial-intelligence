# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_industrial_estate
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# Optional explicit dashboard connection URL. Leave blank to use DB_* above.
# DATABASE_URL=postgresql+psycopg2://postgres:your-url-encoded-password@localhost:5432/smart_industrial_estate
DATABASE_URL=

# Facility profile
FACILITY_PROFILE=Industrial Estate
ESTATE_LAT=20.29
ESTATE_LON=85.84

# Local AI Assistant
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=60

# Optional service endpoints
ASSISTANT_URL=http://127.0.0.1:8000/api/ask
SIMULATION_URL=

# Sensor simulation (defaults to the latest 7 days when dates are omitted)
SIM_INTERVAL=60
SIM_BATCH_SIZE=10
SIM_WINDOW_DAYS=7
SIM_NUM_SENSORS=50
SIM_START_DATE=
SIM_END_DATE=
